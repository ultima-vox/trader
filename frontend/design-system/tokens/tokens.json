{
  "$schema": "https://design-tokens.org/community-group/format/",
  "meta": {
    "name": "Vox Trader",
    "version": "1.0.0",
    "theme": "dark-terminal",
    "baseFontSize": "13px",
    "baseSpacingUnit": "4px",
    "defaultDensity": "compact",
    "primaryLanguage": "ru"
  },
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F7F8FA",
      "100": "#EEF0F3",
      "200": "#D9DDE3",
      "300": "#B8BEC8",
      "400": "#929AA7",
      "500": "#707986",
      "600": "#515966",
      "700": "#383F49",
      "800": "#252A32",
      "850": "#1D2229",
      "900": "#161A20",
      "925": "#12161B",
      "950": "#0D1014",
      "1000": "#080A0D"
    },
    "blue": {
      "300": "#78B7FF",
      "400": "#4C9FFF",
      "500": "#2788F5",
      "600": "#176FD1",
      "700": "#1158AA"
    },
    "positive": {
      "base": "#27B07D",
      "strong": "#159466",
      "surface": "rgba(39,176,125,0.10)",
      "on": "#08120E",
      "flash": "rgba(39,176,125,0.28)",
      "pressed": "#0F7D55"
    },
    "negative": {
      "base": "#E45858",
      "strong": "#CA3F3F",
      "surface": "rgba(228,88,88,0.10)",
      "surfaceHover": "rgba(228,88,88,0.14)",
      "surfaceActive": "rgba(228,88,88,0.22)",
      "on": "#1A0A0A",
      "flash": "rgba(228,88,88,0.28)",
      "outline": "rgba(228,88,88,0.50)",
      "pressed": "#A93333"
    },
    "warning": {
      "base": "#D9A441",
      "strong": "#BD8621",
      "surface": "rgba(217,164,65,0.11)",
      "surfaceStrong": "rgba(217,164,65,0.14)"
    },
    "info": {
      "base": "#5794E6",
      "surface": "rgba(87,148,230,0.10)"
    },
    "unknown": {
      "base": "#A77BE8",
      "surface": "rgba(167,123,232,0.11)",
      "surfaceSubtle": "rgba(167,123,232,0.06)"
    }
  },
  "bg": {
    "canvas": "#0D1014",
    "workspace": "#12161B",
    "surface": "#161A20",
    "surfaceHover": "#1D2229",
    "elevated": "#252A32",
    "input": "#12161B"
  },
  "border": {
    "subtle": "#252A32",
    "default": "#303741",
    "strong": "#454D59",
    "focus": "#2788F5"
  },
  "text": {
    "primary": "#EDF0F4",
    "secondary": "#B8BEC8",
    "tertiary": "#858E9B",
    "disabled": "#59616C"
  },
  "risk": {
    "safe": "#27B07D",
    "warning": "#D9A441",
    "blocked": "#E45858",
    "unknown": "#A77BE8"
  },
  "protection": {
    "stopLoss": {
      "color": "warning.base",
      "surface": "warning.surface"
    },
    "takeProfit": {
      "color": "positive.base",
      "surface": "positive.surface"
    },
    "trailing": {
      "color": "info.base",
      "surface": "info.surface"
    },
    "inherited": {
      "color": "text.tertiary",
      "surface": "bg.surfaceHover"
    },
    "precedence": [
      "order/position override",
      "strategy policy",
      "portfolio/account default"
    ],
    "note": "A default is not a hard risk limit; guardrails are a separate policy. Changing a default never silently rewrites existing broker stop orders."
  },
  "typography": {
    "fontUi": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, monospace",
    "scale": {
      "11": "caption / secondary technical",
      "12": "dense table / order book",
      "13": "primary terminal UI (base)",
      "14": "controls / body",
      "16": "widget title / emphasised value",
      "18": "section headline",
      "22": "large metric",
      "28": "exceptional dashboard metric"
    },
    "weights": [
      400,
      500,
      600,
      700
    ],
    "numeric": "font-variant-numeric: tabular-nums"
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "radius": {
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8
  },
  "shadow": {
    "dropdown": "0 8px 24px rgba(0,0,0,0.55)",
    "modal": "0 12px 32px rgba(0,0,0,0.60)"
  },
  "motion": {
    "fast": 80,
    "normal": 120,
    "slow": 180,
    "flash": 480
  },
  "density": {
    "compact": {
      "control": 28,
      "row": 26,
      "header": 28,
      "widgetHeader": 32,
      "default": true
    },
    "standard": {
      "control": 32,
      "row": 30,
      "header": 32,
      "widgetHeader": 36
    },
    "comfortable": {
      "control": 36,
      "row": 36,
      "header": 36,
      "widgetHeader": 36
    }
  },
  "breakpoints": {
    "wide": 1600,
    "primaryDesktop": 1440,
    "laptop": 1280,
    "supervisory": 1024,
    "belowSupervisory": "separate responsive workflow — the desktop grid is not shrunk"
  },
  "chartMarkers": {
    "B": {
      "meaning": "buy",
      "color": "#27B07D",
      "style": "filled"
    },
    "S": {
      "meaning": "sell",
      "color": "#E45858",
      "style": "filled"
    },
    "F": {
      "meaning": "fill",
      "color": "#4C9FFF",
      "style": "filled"
    },
    "SL": {
      "meaning": "stop loss",
      "color": "#D9A441",
      "style": "outline"
    },
    "TP": {
      "meaning": "take profit",
      "color": "#27B07D",
      "style": "outline"
    },
    "D": {
      "meaning": "dividend",
      "color": "#A77BE8",
      "style": "outline"
    },
    "E": {
      "meaning": "corporate / system event",
      "color": "#5794E6",
      "style": "outline"
    }
  }
}
