  "common": {
    "auth": "matching production or sandbox token; account must be accessible; trade permission required for mutations",
    "exactness": "protobuf unit+nano only; preserve optional presence, currencies, timestamps and unknown enum numbers",
    "mutation": "persist UNKNOWN_AFTER_DISPATCH before send; one transport attempt; reconcile by broker readback/stream; never blind retry",
    "stream": "long-lived server stream without unary deadline; bounded queue; stale detection; bounded jittered reconnect; restore exact account subscription",
    "constraints": "non-empty account/instrument/order identities; positive lots; limit requires price; market/best-price omit price; TIF only for limit; request UUID <=36",
    "price_conventions": "environment- and operation-aware explicit PriceType from authoritative instrument kind: production PostOrder/PostOrderAsync/ReplaceOrder/GetOrderState use CURRENCY for shares/ETF/currency/bonds and POINT for futures sourced in points; production PostStopOrder and all Sandbox mutation inputs use CURRENCY; UNSPECIFIED is forbidden at the adapter boundary",
    "price_convention_source": "https://developer.tbank.ru/invest/intro/useful-info/points",
    "stop_constraints": "native stop loss/take profit/stop limit/trailing; GTC or valid GTD; native relative/absolute trailing; no synthetic trailing",
    "trailing_activation": "TAKE_PROFIT+TRAILING with positive typed indent; delayed activation requires stop_price not already reached for position direction and instant_execution=false; immediate activation omits stop_price and sets instant_execution=true; explicit and immediate activation are mutually exclusive; 30035 means invalid stop_price"
  },
