{
  "schema_version": 1,
  "issue": 11,
  "suite": "cargo test --locked -p vox-runtime --test runtime_chaos",
  "scenarios": [
    { "id": 1, "scenario": "clean startup with flat account", "test": "clean_startup_existing_position_and_read_only_authorization_are_safe" },
    { "id": 2, "scenario": "restart with open regular order", "test": "restart_with_vox_owned_open_order_and_stop_converges_without_mutation" },
    { "id": 3, "scenario": "restart with open stop/protection", "test": "restart_with_vox_owned_open_order_and_stop_converges_without_mutation" },
    { "id": 4, "scenario": "restart with existing position", "test": "clean_startup_existing_position_and_read_only_authorization_are_safe" },
    { "id": 5, "scenario": "crash after durable dispatch fence before transport", "test": "cancel_absence_never_fabricates_rejection_or_success" },
    { "id": 6, "scenario": "possible dispatch before ACK", "test": "unknown_survives_restart_resolves_from_direct_readback_without_replay" },
    { "id": 7, "scenario": "persisted UNKNOWN restart", "test": "unknown_survives_restart_resolves_from_direct_readback_without_replay" },
    { "id": 8, "scenario": "broker disconnect while READY", "test": "stream_gap_closes_gate_reconnects_and_reconciles" },
    { "id": 9, "scenario": "stream gap reconnect reconciliation", "test": "stream_gap_closes_gate_reconnects_and_reconciles" },
    { "id": 10, "scenario": "duplicate/replayed stream events", "test": "duplicate_and_stale_epoch_events_are_idempotent" },
    { "id": 11, "scenario": "stream before unary", "test": "duplicate_and_stale_epoch_events_are_idempotent" },
    { "id": 12, "scenario": "unary before stream", "test": "duplicate_and_stale_epoch_events_are_idempotent" },
    { "id": 13, "scenario": "temporary 429 reset metadata", "test": "safe_reads_retry_429_and_transient_failures_with_bound" },
    { "id": 14, "scenario": "temporary transport/5xx", "test": "safe_reads_retry_429_and_transient_failures_with_bound" },
    { "id": 15, "scenario": "invalid credential", "test": "invalid_credential_and_inaccessible_account_fail_closed" },
    { "id": 16, "scenario": "account inaccessible", "test": "invalid_credential_and_inaccessible_account_fail_closed" },
    { "id": 17, "scenario": "optional capability permission failure", "test": "policy::tests::readiness_matrix_fails_closed" },
    { "id": 18, "scenario": "local expectation conflicts", "test": "position_conflict_and_stream_overflow_force_reconciliation" },
    { "id": 19, "scenario": "manual order/stop preserved", "test": "manual_order_and_orphan_stop_are_preserved_and_halt_runtime" },
    { "id": 20, "scenario": "stale checkpoint", "test": "corrupt_checkpoint_rebuilds_but_corrupt_unknown_evidence_fails_closed" },
    { "id": 21, "scenario": "corrupt non-critical checkpoint", "test": "corrupt_checkpoint_rebuilds_but_corrupt_unknown_evidence_fails_closed" },
    { "id": 22, "scenario": "corrupt unresolved evidence", "test": "corrupt_checkpoint_rebuilds_but_corrupt_unknown_evidence_fails_closed" },
    { "id": 23, "scenario": "clean graceful shutdown", "test": "clean_startup_existing_position_and_read_only_authorization_are_safe" },
    { "id": 24, "scenario": "shutdown with ambiguous mutation", "test": "graceful_shutdown_preserves_ambiguous_mutation_and_releases_ownership" },
    { "id": 25, "scenario": "second runtime ownership", "test": "store::tests::second_store_fails_single_writer_lock" },
    { "id": 26, "scenario": "stale old epoch event", "test": "duplicate_and_stale_epoch_events_are_idempotent" },
    { "id": 27, "scenario": "bounded queue overflow", "test": "position_conflict_and_stream_overflow_force_reconciliation" },
    { "id": 28, "scenario": "schema migration with UNKNOWN", "test": "store::tests::epoch_fences_old_work_and_unknown_survives_restart" },
    { "id": 29, "scenario": "60-minute resource soak", "test": "qualification/live/runtime_soak.ps1 -Minutes 60" }
  ]
}
