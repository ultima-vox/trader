  "wire_strategy": {
    "kind": "prost-tonic-generated-grpc",
    "rest_role": "compatibility-cross-check-only"
  },
  "unary_methods": [
    {"method":"GetCandles","request":"GetCandlesRequest","response":"GetCandlesResponse","retry":"safe-read","canonical":"CanonicalCandle","constraints":"required from/to/interval; interval span+limit; range exceeds timeframe; maximum one calendar year; candle_source_type mutually exclusive with limit (30220, local typed rejection); deterministic chunk+dedup"},
    {"method":"GetLastPrices","request":"GetLastPricesRequest","response":"GetLastPricesResponse","retry":"safe-read","canonical":"last-price fact; never quote","constraints":"empty identifiers means all available; generated price-type/status enums; maximum 3000 instruments (30218)"},
    {"method":"GetOrderBook","request":"GetOrderBookRequest","response":"GetOrderBookResponse","retry":"safe-read","canonical":"CanonicalOrderBook","constraints":"required instrument identifier; depth one of 1,10,20,30,40,50 (30031/30032)"},
    {"method":"GetTradingStatus","request":"GetTradingStatusRequest","response":"GetTradingStatusResponse","retry":"safe-read","canonical":"provider status + flags","constraints":"required instrument identifier"},
    {"method":"GetTradingStatuses","request":"GetTradingStatusesRequest","response":"GetTradingStatusesResponse","retry":"safe-read","canonical":"provider status + flags","constraints":"identifier array; maximum 3000 instruments (30218)"},
    {"method":"GetLastTrades","request":"GetLastTradesRequest","response":"GetLastTradesResponse","retry":"safe-read","canonical":"CanonicalTrade","constraints":"required instrument/from/to; increasing range; generated trade-source enum; provider guarantees last hour"},
    {"method":"GetClosePrices","request":"GetClosePricesRequest","response":"GetClosePricesResponse","retry":"safe-read","canonical":"exact close facts","constraints":"empty instruments means all available; non-empty supplied identifiers; generated optional status enum"},
    {"method":"GetTechAnalysis","request":"GetTechAnalysisRequest","response":"GetTechAnalysisResponse","retry":"safe-read","canonical":"exact optional indicator values","constraints":"required indicator/uid/from/to/interval/price type; indicator-specific length/deviation/smoothing (30213-30217)"},
    {"method":"GetMarketValues","request":"GetMarketValuesRequest","response":"GetMarketValuesResponse","retry":"safe-read","canonical":"typed provider values","constraints":"generated identifier/value arrays and enums; open-interest futures-only; theoretical-price options-only"}
  ],
  "stream_methods": [
    {"method":"MarketDataStream","shape":"bidirectional","production":true,"recovery":"adapter desired-state resubscribe"},
    {"method":"MarketDataServerSideStream","shape":"server-streaming","production":false,"role":"generated compatibility surface"}
  ],
  "stream_request_payloads": ["subscribe_candles_request","subscribe_order_book_request","subscribe_trades_request","subscribe_info_request","subscribe_last_price_request","get_my_subscriptions","ping","ping_settings"],
  "stream_response_payloads": ["subscribe_candles_response","subscribe_order_book_response","subscribe_trades_response","subscribe_info_response","candle","trade","orderbook","trading_status","ping","subscribe_last_price_response","last_price","open_interest"],
  "limits": {
    "limited_subscriptions_per_stream": 300,
    "subscription_requests_per_minute": 100,
    "stream_connections": 32,
    "ping_delay_ms_min": 5000,
    "ping_delay_ms_default": 120000,
    "ping_delay_ms_max": 180000
  }
